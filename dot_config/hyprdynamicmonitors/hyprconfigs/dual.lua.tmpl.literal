{{if isLidClosed}}
hl.monitor({
  output = "eDP-1",
  disabled = true,
})
hl.monitor({
  output = "HDMI-A-1",
  mode = "preferred",
  position = "auto",
  scale = "2",
})
{{else}}
hl.monitor({
  output = "eDP-1",
  mode = "3024x1890@120",
  position = "0x0",
  scale = 2,
})
hl.monitor({
  output = "HDMI-A-1",
  mode = "preferred",
  position = "auto",
  scale = "2",
})

{{end}}
