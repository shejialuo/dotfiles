{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "deny",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "allow"
  },
  "lsp": false,
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
