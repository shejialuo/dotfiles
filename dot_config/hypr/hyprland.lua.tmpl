------------------------------------------------------------
-- Workspaces operations
------------------------------------------------------------

for i = 1, 8 do
  local key = tostring(i)

  -- switch to workspace
  hl.bind(
    mod .. " + " .. key,
    hl.dsp.focus({
      workspace = i,
    })
  )

  -- move window silently, stay on current workspace
  hl.bind(
    mod .. " + CTRL + " .. key,
    hl.dsp.window.move({
      workspace = i,
      follow = false,
    })
  )

  -- move window and follow it
  hl.bind(
    mod .. " + SHIFT + " .. key,
    hl.dsp.window.move({
      workspace = i,
      follow = true,
    })
  )
end

